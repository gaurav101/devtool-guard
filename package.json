{
  "name": "devtool-guard",
  "version": "0.1.0",
  "description": "Zero-dependency DevTools detection and deterrence for the browser",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test tests/*.test.js",
    "test:coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-include='dist/**/*.js' --test-coverage-exclude='dist/lib/types.js' --test-coverage-lines=95 --test-coverage-branches=95 --test-coverage-functions=95 tests/*.test.js",
    "prepack": "npm run build"
  },
  "devDependencies": { "typescript": "^5.6.0" },
  "license": "MIT"
}
